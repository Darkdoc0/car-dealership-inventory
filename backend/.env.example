# Copy this file to `.env` and replace every <placeholder>. `.env` is git-ignored: never commit real values.

# PostgreSQL connection used by the app (npm run dev, npm start, npm run seed, npm run seed:admin).
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/car_dealership

# PostgreSQL connection used by the tests. THIS DATABASE IS WIPED by `npm test` and by the e2e suite.
TEST_DATABASE_URL=postgresql://postgres:<password>@localhost:5432/car_dealership_test

# Port the API listens on.
PORT=3000

# Signs login tokens. Use a long random string. With NODE_ENV=production it must be at least 32 characters.
JWT_SECRET=<long-random-string>

# Only for `npm run seed:admin`, which creates (or promotes) this one admin. `npm run seed` ignores them
# and uses the fixed demo logins listed in the README.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=<strong-password>
