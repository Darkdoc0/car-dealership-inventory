# Optional. Copy this file to `.env` to change how `npm run dev` runs. `.env` is git-ignored.
# Both values below are the defaults, and neither is a secret.

# Port the Vite dev server listens on.
PORT=5173

# Where the dev server forwards /api requests. Point it at the running backend (see PORT in backend/.env).
API_PROXY_TARGET=http://localhost:3000
